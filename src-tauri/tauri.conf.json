{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nook",
  "version": "0.1.3",
  "identifier": "dev.nook.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "conpty/conpty.dll": "conpty.dll",
      "conpty/OpenConsole.exe": "OpenConsole.exe",
      "conpty/LICENSE": "conpty-LICENSE.txt",
      "../src/fonts/OFL.txt": "Libron-LICENSE.txt",
      "mod/.claude-plugin/plugin.json": "mod/.claude-plugin/plugin.json",
      "mod/hooks/hooks.json": "mod/hooks/hooks.json",
      "mod/hooks/register.js": "mod/hooks/register.js",
      "mod/types/index.d.ts": "mod/types/index.d.ts",
      "mod/themes/nook.json": "mod/themes/nook.json",
      "../themes/": "themes/",
      "../src/fonts/FluentIcons-LICENSE.txt": "FluentIcons-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
